new file mode 100644
index 0000000..b29daba
--- /dev/null
+++ b/kernels/bench/b4_unified.py
@@ -0,0 +1,67 @@
+"""Session-7 B4 — one harness for FA2 and fused v2, to end the +13.1% / +18.2% split.
+
+Two baselines were in circulation: the J0 micro-benchmark measured FA2 at
+6.913 ms, while the v2 sweep quoted "+13.1%" against something near 7.2 ms.
+Numbers taken from different harnesses cannot be divided by each other, so this
+measures every path in one process, one warm-up policy, one timing method.
+"""
+import json, os, sys, time
+import torch
+
+sys.path.insert(0, os.path.expanduser("~/gpu/Self-Forcing/kernels"))
+from triton_kv_quant import triton_quantize_kv
+from triton_fused_lowbit_attn import fused_lowbit_attention_v2
+import flash_attn
+
+B, H, D = 1, 12, 128
+CHUNK, WINDOW = 4680, 32760
+DEV = "cuda"
+WARM, ITER = 10, 30
+
+
+def timed(fn):
+    for _ in range(WARM):
+        fn()
+    torch.cuda.synchronize()
+    ev = [(torch.cuda.Event(True), torch.cuda.Event(True)) for _ in range(ITER)]
+    for a, b in ev:
+        a.record(); fn(); b.record()
+    torch.cuda.synchronize()
+    ms = sorted(a.elapsed_time(b) for a, b in ev)
+    return ms[len(ms) // 2]
+
+
+torch.manual_seed(0)
+q = torch.randn(B, CHUNK, H, D, device=DEV, dtype=torch.bfloat16)
+k = torch.randn(B, WINDOW, H, D, device=DEV, dtype=torch.bfloat16)
+v = torch.randn(B, WINDOW, H, D, device=DEV, dtype=torch.bfloat16)
+scale = 1.0 / D ** 0.5
+res = {}
+
+res["fa2_bf16"] = timed(lambda: flash_attn.flash_attn_func(q, k, v, softmax_scale=scale))
+
+for kb, vb, tag in ((4, 4, "int4"), (4, 2, "k4v2"), (2, 2, "int2")):
+    seg = WINDOW - CHUNK
+    pk, ks = triton_quantize_kv(k[:, :seg].contiguous(), kb)
+    pv, vs = triton_quantize_kv(v[:, :seg].contiguous(), vb)
+    sk, sv = k[:, seg:].contiguous(), v[:, seg:].contiguous()
+    nb = (CHUNK + 15) // 16
+    for lam, lt in ((0.0, ""), (1.0, "_bias")):
+        res[f"fused_{tag}{lt}"] = timed(
+            lambda kb=kb, vb=vb, lam=lam: fused_lowbit_attention_v2(
+                q, pk, ks, pv, vs, sk, sv, key_bits=kb, value_bits=vb,
+                bias_lambda=lam, seg_len=CHUNK, seg_nb=nb,
+                block_m=128, block_n=32, num_warps=4, num_stages=2))
+
+base = res["fa2_bf16"]
+print(f"{'path':22s} {'ms':>8s} {'vs FA2':>10s}")
+print("-" * 42)
+for kk, vv in res.items():
+    print(f"{kk:22s} {vv:8.3f} {100*vv/base-100:+9.1f}%")
+out = {"shapes": {"B": B, "H": H, "D": D, "chunk": CHUNK, "window": WINDOW},
+       "method": f"CUDA events, median of {ITER} after {WARM} warm-up, one process",
+       "commit": os.popen("git rev-parse HEAD").read().strip(),
+       "ms": res, "pct_vs_fa2": {k_: 100 * v_ / base - 100 for k_, v_ in res.items()}}
+json.dump(out, open(os.path.expanduser(
+    "~/gpu/Self-Forcing/results/session6/gateB4_kernel_unified.json"), "w"), indent=1)
+print("\nwrote results/session6/gateB4_kernel_unified.json")
