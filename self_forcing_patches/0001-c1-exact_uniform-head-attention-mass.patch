+#!/usr/bin/env bash
+# C6 — "정확형 b≈177 이므로 exp(-177)≈0, 즉 캐시가 억제된다"(주장 B10) 검증.
+#
+# 이 주장은 지금까지 **수식에서 유추한 것**이고 측정된 적이 없어 claim_table 에
+# '불가'로 남아 있다. attention mass 를 직접 읽어 확정하거나 철회한다.
+#
+# head 평균 mass 로는 볼 수 없다 — 문제의 b≈177 은 층 29의 **한 head** 성질이다.
+# 그래서 per-head 기록을 새로 넣었다(--tum_mass_perhead).
+#
+# 세 팔, 같은 조건(INT2, 63프레임, seed 0):
+#   lam0    보정 없음(λ=0) — 기준 mass
+#   taylor  현재 경로
+#   exact   수치 안정형 정확형(C1) — 주장의 대상
+set -u
+cd ~/gpu/sf-c1
+. tools/runlib.sh 2>/dev/null || . ~/gpu/Self-Forcing/tools/runlib.sh
+PY=~/gpu/sf-venv/bin/python
+O=results/session7/c6
+mkdir -p $O
+
+arm () { tag="$1"; shift
+  s6_run "c6_$tag" $PY inference.py --config_path configs/gateA_A1.yaml \
+    --checkpoint_path checkpoints/self_forcing_dmd.pt \
+    --data_path prompts/quant3/prompts3.txt --output_folder $O/$tag/videos \
+    --stats_path $O/$tag.stats.json \
+    --num_output_frames 63 --seed 0 --use_ema --no_decode \
+    --kv_quant RTN --kv_bits 2 --tum_correct \
+    --tum_mass_chunks 1 6 20 --tum_mass_perhead $O/$tag.perhead.json "$@"; }
+
+arm lam0   --tum_mode taylor        --tum_lambda 0
+arm taylor --tum_mode taylor        --tum_lambda 1
+arm exact  --tum_mode exact_uniform --tum_lambda 1
+
+s6_run c6_analyse $PY gateC6_mass.py --dir $O \
+  --out ~/gpu/Self-Forcing/results/session6/gateC6_mass
+
+s6_verdict C6
