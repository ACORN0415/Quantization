+# -*- coding: utf-8 -*-
+"""C6 — 보정이 캐시 attention mass 를 실제로 억제하는가.
+
+주장 B10: "정확형에서 outlier head 의 b 가 ~177 이므로 캐시 logit 에 그만큼을 빼면
+exp(-177)≈0 이 되어 캐시가 사실상 꺼진다." 지금까지 **수식에서 유추**한 것이고
+측정된 적이 없다. 여기서 확정하거나 철회한다.
+
+읽는 값은 head 별 self / cached mass 다. head 평균이면 층 29의 한 head 가
+나머지 11개에 묻힌다 — 그 희석이 지금까지 이 주장을 확인하지 못한 이유다.
+
+판정:
+  억제가 사실이라면 exact 팔의 층 29 outlier head 에서 cached mass 가 lam0 대비
+  거의 0 으로 떨어져야 한다. 떨어지지 않으면 주장을 철회한다.
+"""
+import argparse, json, os, statistics as st
+
+
+def load(path):
+    d = json.load(open(path))
+    return d["records"]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--dir", required=True)
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+
+    arms = {}
+    for tag in ("lam0", "taylor", "exact"):
+        p = os.path.join(a.dir, f"{tag}.perhead.json")
+        if not os.path.exists(p):
+            print(f"없음: {p}")
+            continue
+        arms[tag] = load(p)
+    if "lam0" not in arms:
+        raise SystemExit("기준 팔(lam0)이 없다")
+
+    def by(recs, layer, chunk):
+        return {r["head"]: r for r in recs
+                if r.get("layer") == layer and r.get("chunk") == chunk}
+
+    layers = sorted({r["layer"] for r in arms["lam0"] if "layer" in r})
+    chunks = sorted({r["chunk"] for r in arms["lam0"] if "chunk" in r})
+    print(f"층 {layers} · chunk {chunks} · 팔 {list(arms)}")
+
+    rows = []
+    for c in chunks:
+        for l in layers:
+            base = by(arms["lam0"], l, c)
+            if not base:
+                continue
+            for tag in ("taylor", "exact"):
+                if tag not in arms:
+                    continue
+                cur = by(arms[tag], l, c)
+                for h, r0 in base.items():
+                    if h not in cur:
+                        continue
+                    rows.append({
+                        "chunk": c, "layer": l, "head": h, "arm": tag,
+                        "cached_lam0": r0.get("cached"),
+                        "cached": cur[h].get("cached"),
+                        "self_lam0": r0.get("self"),
+                        "self": cur[h].get("self"),
+                    })
+
+    print(f"\n{'chunk':>6}{'layer':>6}{'arm':>8}"
+          f"{'cached 최소(head)':>18}{'그 head':>8}{'lam0 값':>10}{'비':>8}")
+    verdict = {}
+    for c in chunks:
+        for l in layers:
+            for tag in ("taylor", "exact"):
+                sel = [r for r in rows if r["chunk"] == c and r["layer"] == l
+                       and r["arm"] == tag and r["cached"] is not None]
+                if not sel:
+                    continue
+                m = min(sel, key=lambda r: r["cached"])
+                ratio = m["cached"] / max(m["cached_lam0"], 1e-12)
+                print(f"{c:6d}{l:6d}{tag:>8}{m['cached']:18.6f}"
+                      f"{m['head']:8d}{m['cached_lam0']:10.6f}{ratio:8.4f}")
+                verdict[f"c{c}_l{l}_{tag}"] = {
+                    "min_cached_head": m["head"], "cached": m["cached"],
+                    "cached_lam0": m["cached_lam0"], "ratio": ratio}
+
+    # 억제 판정: exact 팔에서 lam0 대비 비가 0.01 미만인 (chunk, layer, head) 존재?
+    supp = [k for k, v in verdict.items() if k.endswith("_exact")
+            and v["ratio"] < 0.01]
+    print("\n판정:")
+    if supp:
+        print(f"  **억제 관측됨** — {supp}")
+    else:
+        worst = min((v["ratio"] for k, v in verdict.items()
+                     if k.endswith("_exact")), default=float("nan"))
+        print(f"  억제 관측되지 않음. exact 팔 최소 비 {worst:.4f} "
+              f"(0.01 미만이어야 '캐시가 꺼진다'는 서술이 성립)")
+        print("  → 주장 B10 은 **철회**한다.")
+
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    json.dump({"verdict_rows": verdict, "suppressed": supp,
+               "n_rows": len(rows), "rows": rows},
+              open(a.out + ".json", "w"), indent=1, ensure_ascii=False)
+    print(f"\nwrote {a.out}.json")
+
+
+if __name__ == "__main__":
+    main()
