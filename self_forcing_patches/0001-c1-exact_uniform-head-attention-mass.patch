+def log_sinh_over_x_stable(a):
+    """log(sinh a / a), evaluated without a convergence radius. a >= 0.
+
+    The shipped `exact_uniform` used an 8-term power series, whose radius is pi.
+    Gate C2 measured |a| up to 192 on the layer-29 outlier head, where that
+    series diverges (max abs difference 2.3e+27 against this function). This is
+    the replacement: the small-a branch is the same series truncated where it is
+    accurate, the large-a branch is the closed form
+        log(sinh a / a) = a - log(2a) + log1p(-exp(-2a)),
+    which is stable for every a the cache produces.
+    """
+    # The branch point is 1, not something tiny: the closed form subtracts two
+    # nearly equal quantities as a -> 0 (a - log 2a and log1p(-e^-2a) are both
+    # ~6.2 at a = 1e-3 while their sum is ~1.7e-7), which costs ~7 digits in
+    # float32. The series is accurate to ~6e-10 below 1, the closed form to
+    # ~1e-7 above it, so switching at 1 keeps the whole range near 1e-7.
+    a = a.abs()
+    out = torch.empty_like(a)
+    small = a < 1.0
+    s_ = a[small].double()
+    s2 = s_ * s_
+    acc = torch.zeros_like(s_)
+    term = s2.clone()
+    for c in _LOG_SINH_COEFFS:
+        acc = acc + c * term
+        term = term * s2
+    out[small] = acc.to(out.dtype)
+    l_ = a[~small]
+    out[~small] = l_ - torch.log(2.0 * l_) + torch.log1p(-torch.exp(-2.0 * l_))
+    return out
+
+
