+        json.dump({"mode": args.tum_mode, "lambda": args.tum_lambda,
+                   "kv_bits": args.kv_bits, "records": _ph}, f)
+    print(f"[tum] per-head mass {len(_ph)}건 -> {args.tum_mass_perhead}")
+
 if args.tum_mass_chunks and local_rank == 0:
     import tum_correction as _tcm
