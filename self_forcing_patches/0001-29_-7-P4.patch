+"""Session-7 C2 (합산) — 실제로 적용되는 보정량에서 Taylor가 충분한가.
+
+`gateC2_taylor.py`는 **채널별** a에서 Taylor 오차를 본다. 그러나 코드가 logit에
+더하는 양은 **128채널의 합**이다. 리뷰가 지적한 대로 둘은 다른 양이며, 합산하면
+채널별로는 작던 오차가 한쪽으로 쌓인다.
+
+  b_taylor = sum_c a_ic^2 / 6         (= (1/24d) sum_c q_c^2 Delta_ic^2)
+  b_exact  = sum_c log(sinh a_ic / a_ic)      a_ic = |q_c| Delta_ic / (2 sqrt d)
+
+기준은 **수치 안정형** log(sinh a/a)이고, 출하 급수의 오차는 세 번째 열로 따로 낸다.
+
+이 파일은 `gateC2_summed.json`을 만든 즉석 실행을 **복원**한 것이다. 원본이
+디스크에 없어 B7·B8 주장의 재현 경로가 없었다. 회귀: 1프롬프트 덤프에서 저장된
+JSON을 재현해야 한다(`--regress`).
+"""
+import argparse, json, math, os, sys
+
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from gateC2_taylor import log_sinh_over_x, shipped_series, q
+
+
+def analyse(r, max_pairs=200_000, seed=0):
+    ds = r["delta_sq_blk"].double()          # [nb, H, D]
+    qs = r["q_sub"].double()                 # [nq, H, D]
+    D = ds.shape[-1]
+    nbc = (r["self_rel"][0] + 15) // 16
+    if nbc < 8:
+        return None
+    delta = ds[:nbc].clamp(min=0).sqrt()                     # [nbc, H, D]
+    # a[iq, ib, h, c]
+    aa = (qs.abs().unsqueeze(1) * delta.unsqueeze(0)) / (2.0 * math.sqrt(D))
+    aa = aa.reshape(-1, aa.shape[-1])                        # [pairs, D]
+    if aa.shape[0] > max_pairs:
+        g = torch.Generator().manual_seed(seed)
+        idx = torch.randperm(aa.shape[0], generator=g)[:max_pairs]
+        aa = aa[idx]
+    b_exact = log_sinh_over_x(aa).sum(-1)
+    b_taylor = (aa ** 2 / 6.0).sum(-1)
+    b_shipped = shipped_series(aa).sum(-1)
+    abs_err = (b_taylor - b_exact).abs()
+    ok = b_exact > 1e-6
+    rel = torch.zeros_like(b_exact)
+    rel[ok] = abs_err[ok] / b_exact[ok]
+    return {
+        "prompt": int(r.get("prompt", 0)),
+        "chunk": int(r["chunk"]), "layer": int(r["layer"]),
+        "b_exact_med": float(b_exact.median()),
+        "b_taylor_med": float(b_taylor.median()),
+        "rel_p50": q(rel[ok], (0.5,))["p50"] if ok.any() else float("nan"),
+        "rel_p95": q(rel[ok], (0.95,))["p95"] if ok.any() else float("nan"),
+        "rel_p99": q(rel[ok], (0.99,))["p99"] if ok.any() else float("nan"),
+        "rel_max": float(rel.max()),
+        "abs_p95": q(abs_err, (0.95,))["p95"],
+        "abs_max": float(abs_err.max()),
+        "shipped_max_abs": float((b_shipped - b_exact).abs().max()),
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--dump", default="results/session6/l3_bias_dump.pt")
+    ap.add_argument("--out", default="results/session6/gateC2_summed")
+    ap.add_argument("--regress", default=None,
+                    help="이 JSON을 재현하는지 확인하고 종료")
+    a = ap.parse_args()
+
+    recs = torch.load(a.dump, map_location="cpu", weights_only=False)
+    rows = [x for x in (analyse(r) for r in recs) if x]
+    prompts = sorted({x["prompt"] for x in rows})
+    print(f"{len(recs)} records / {len(rows)} rows / prompts {prompts}")
+
+    if a.regress:
+        ref = json.load(open(a.regress))
+        keys = [k for k in ref[0]]
+        bad = 0
+        for x, y in zip(rows, ref):
+            for k in keys:
+                if abs(x[k] - y[k]) > 1e-9 * max(1.0, abs(y[k])):
+                    print(f"  차이 {k} chunk{x['chunk']} L{x['layer']}: "
+                          f"{x[k]!r} vs {y[k]!r}")
+                    bad += 1
+        print("재현 불일치" if bad else f"저장된 {len(ref)}행을 정확히 재현")
+        return
+
+    print(f"\n{'p':>2} {'chunk':>6} {'layer':>6} {'b_exact_med':>12} "
+          f"{'b_taylor_med':>13} {'rel_p95':>9} {'과대율(med)':>12}")
+    for x in rows:
+        over = x["b_taylor_med"] / max(x["b_exact_med"], 1e-12)
+        print(f"{x['prompt']:2d} {x['chunk']:6d} {x['layer']:6d} "
+              f"{x['b_exact_med']:12.4f} {x['b_taylor_med']:13.4f} "
+              f"{x['rel_p95']:9.4f} {over:11.2f}x")
+
+    if len(prompts) > 1:
+        print("\n(chunk, layer)별 프롬프트 간 변동 — 군집 단위는 프롬프트다")
+        print(f"{'chunk':>6} {'layer':>6} {'과대율 min':>11} {'med':>9} {'max':>9}")
+        for c, l in sorted({(x["chunk"], x["layer"]) for x in rows}):
+            o = sorted(x["b_taylor_med"] / max(x["b_exact_med"], 1e-12)
+                       for x in rows if (x["chunk"], x["layer"]) == (c, l))
+            print(f"{c:6d} {l:6d} {o[0]:10.2f}x {o[len(o)//2]:8.2f}x "
+                  f"{o[-1]:8.2f}x")
+
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    json.dump(rows, open(a.out + ".json", "w"), indent=1)
+    print(f"\nwrote {a.out}.json")
+
+
+if __name__ == "__main__":
+    main()
