+++ b/tools/b2_final_vs_bf16.py
@@ -0,0 +1,44 @@
+# -*- coding: utf-8 -*-
+"""B2 최종 경로 품질 대비: A4+K4V2+fused bias λ1  vs  릴리스 기본 BF16 (A1).
+
+두 팔은 **서로 다른 배치**에서 나왔다. 그 사실을 출력에 함께 적는다.
+프롬프트 단위 페어링(같은 프롬프트·같은 seed·같은 프레임 수), t 기반 CI.
+"""
+import json, sys, statistics as st
+sys.path.insert(0, "/home/devel/gpu/Quantization/tools")
+from s6stats import paired
+
+OURS = "results/session6/gateB2_final_musiq_per_prompt.json"
+BF16 = "results/session6/gateP0_musiq_per_prompt.json"
+
+def per_prompt(d, arm):
+    """청크 평균을 낸 프롬프트별 MUSIQ."""
+    chunks = d[arm]
+    n = len(chunks[next(iter(chunks))]["musiq"])
+    return [st.fmean(chunks[c]["musiq"][i] for c in chunks) for i in range(n)]
+
+a = per_prompt(json.load(open(OURS)), "final_quality")
+b = per_prompt(json.load(open(BF16)), "ours_bf16")
+assert len(a) == len(b) == 10, (len(a), len(b))
+
+diff = [x - y for x, y in zip(a, b)]
+r = paired(diff, 0.95)
+out = {
+    "arms": {
+        "ours_final": {"source": OURS, "config": "gateA_A4.yaml + fused K4V2 + in-kernel bias lambda=1",
+                       "batch": "run_s7_B234.sh", "mean_musiq": round(st.fmean(a), 4)},
+        "bf16": {"source": BF16, "config": "gateA_A1.yaml, no quantization (릴리스 기본 창)",
+                 "batch": "run_s7_B1_P0.sh", "mean_musiq": round(st.fmean(b), 4)},
+    },
+    "caveat": "두 팔은 같은 스크립트 실행이 아니다. 같은 커밋(e107a36)·같은 프롬프트·seed 0·63프레임이나, 배치가 다르다. 또한 캐시 구성이 A4 vs A1로 다르다 — 이것은 레시피의 일부이므로 의도된 비교이지만, '양자화만의 효과'가 아니다.",
+    "paired_diff_ours_minus_bf16": {
+        "mean": round(r["mean"], 4), "ci95": [round(r["lo"], 4), round(r["hi"], 4)],
+        "t": round(r["t"], 4), "n": r["n"],
+        "sign_agreeing": r["sign"],
+        "sign_positive": sum(d > 0 for d in diff),
+        "per_prompt": [round(d, 4) for d in diff],
+    },
+    "verdict": "차이 검출 안 됨 (CI가 0을 포함). 동등 아님 — TOST 미실시.",
+}
+json.dump(out, open("results/session6/gateB2_final_vs_bf16.json", "w"), indent=1, ensure_ascii=False)
+print(json.dumps(out, indent=1, ensure_ascii=False))
