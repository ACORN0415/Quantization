+# ---- B2c 같은 소스의 BF16 기준선 (분모) --------------------------------------
+s6_run bf16_perf /usr/bin/time -f "%e wall_s" -o $O/bf16_perf.time \
+  $PY inference.py --config_path configs/gateA_A1.yaml \
+  --checkpoint_path checkpoints/self_forcing_dmd.pt \
+  --data_path prompts/quant3/prompts10.txt \
+  --output_folder $O/bf16_perf/videos --stats_path $O/bf16_perf.stats.json \
+  --kv_bytes_report $O/bf16_perf.bytes.json \
+  --num_output_frames 63 --seed 0 --use_ema --no_decode
+
+s6_run musiq $PY /home/devel/gpu/Quantization/tools/metrics_all.py \
+  --runs final_quality=$O/final_quality/videos \
+  --prompts prompts/quant3/prompts10.txt --skip lpips clip flow \
+  --out_csv results/session6/gateB2_final_musiq.csv
+
+# ---- B3 다중 프롬프트 덤프 (L3·C2 일반화) ------------------------------------
+s6_run l3_dump_multi $PY inference.py --config_path configs/gateA_A1.yaml \
+  --checkpoint_path checkpoints/self_forcing_dmd.pt \
+  --data_path prompts/quant3/prompts10.txt \
+  --output_folder $O/l3_multi/videos --stats_path $O/l3_multi.stats.json \
+  --num_output_frames 63 --no_decode --seed 0 --use_ema \
+  --kv_quant RTN --kv_bits 2 --tum_correct --tum_lambda 1 \
