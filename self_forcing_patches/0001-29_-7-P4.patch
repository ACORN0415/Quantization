+#!/usr/bin/env bash
+# B1c — is the ours/pristine mismatch caused ONLY by the base_seed convention?
+#
+# Static reading says yes: our tree passes base_seed to pipeline.inference(),
+# which seeds a per-chunk renoise generator (causal_inference.py:207-209);
+# pristine has no such argument and lets the global RNG run on. That is enough
+# to explain a full trajectory divergence (rel ~ 1.09) without any arithmetic
+# difference. Static reading is not a measurement, so: run our tree with
+# base_seed suppressed and compare against pristine again.
+#
+#   bit-exact  -> the whole difference is the seeding convention
+#   still off  -> something else in the patch stack also changes the BF16 path,
+#                 and we bisect from there
+set -u
+cd ~/gpu/Self-Forcing
+. tools/runlib.sh
+PY=~/gpu/sf-venv/bin/python
+O=results/session6/b1_p0
+s6_run ours_bf16_noseed env S7_SUPPRESS_BASE_SEED=1 $PY inference.py \
+  --config_path configs/gateA_A1.yaml \
+  --checkpoint_path checkpoints/self_forcing_dmd.pt \
+  --data_path prompts/quant3/prompts10.txt \
+  --output_folder $O/ours_bf16_noseed/videos \
+  --latent_dump_root $O/latents_ours_noseed \
+  --num_output_frames 63 --save_with_index --seed 0 --use_ema --no_decode
+s6_run bitexact_noseed $PY - <<'PYG'
+import torch, os
+O = os.path.expanduser('~/gpu/Self-Forcing/results/session6/b1_p0')
+eq = ne = 0; first = None
+for p in range(10):
+    a = f'{O}/latents_ours_noseed/prompt{p:03d}/full.pt'
+    b = f'{O}/latents_pristine/prompt{p:03d}/full.pt'
+    if not (os.path.exists(a) and os.path.exists(b)):
+        print('missing', a if not os.path.exists(a) else b); raise SystemExit(1)
+    x = torch.load(a, map_location='cpu')['latent']
+    y = torch.load(b, map_location='cpu')['latent']
+    if torch.equal(x, y): eq += 1
+    else:
+        ne += 1
+        if first is None:
+            first = (p, ((x.float()-y.float()).norm()/y.float().norm()).item())
+print(f'B1c  ours BF16 (base_seed 억제) vs pristine 33593df: {eq}/{eq+ne} prompts'
+      + ('  PASS — 차이는 전부 시드 규약' if ne == 0
+         else f'  STILL OFF from prompt {first[0]} rel={first[1]:.3e} — 다른 원인이 더 있다'))
