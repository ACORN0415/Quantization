+#!/usr/bin/env bash
+# B1d — 난수 두 갈래를 **모두** 통제한 비교.
+#
+# B1c는 base_seed(중간 재주입)만 껐고 **초기 noise는 여전히 chunk별 전용
+# generator**였다(inference.py:354 부근). 릴리스는 전역 torch.randn 한 번이다.
+# 그래서 B1c의 "다른 원인이 더 있다"는 판정은 성립하지 않는다 — 난수가 아직
+# 통제되지 않은 상태의 불일치였다.
+#
+#   일치  -> 우리/릴리스 차이는 전부 난수 규약(초기 + 재주입)
+#   불일치 -> 그때 비로소 "난수 외 원인"을 이분 탐색한다
+set -u
+cd ~/gpu/Self-Forcing
+. tools/runlib.sh
+PY=~/gpu/sf-venv/bin/python
+O=results/session6/b1_p0
+s6_run ours_release_rng env S7_SUPPRESS_BASE_SEED=1 S7_RELEASE_NOISE=1 $PY inference.py \
+  --config_path configs/gateA_A1.yaml \
+  --checkpoint_path checkpoints/self_forcing_dmd.pt \
+  --data_path prompts/quant3/prompts10.txt \
+  --output_folder $O/ours_release_rng/videos \
+  --latent_dump_root $O/latents_ours_release_rng \
+  --num_output_frames 63 --save_with_index --seed 0 --use_ema --no_decode
+s6_run bitexact_full $PY - <<'PYG'
+import torch, os
+O = os.path.expanduser('~/gpu/Self-Forcing/results/session6/b1_p0')
+eq = ne = 0; first = None
+for p in range(10):
+    a = f'{O}/latents_ours_release_rng/prompt{p:03d}/full.pt'
+    b = f'{O}/latents_pristine/prompt{p:03d}/full.pt'
+    if not (os.path.exists(a) and os.path.exists(b)):
+        print('missing', a if not os.path.exists(a) else b); raise SystemExit(1)
+    x = torch.load(a, map_location='cpu')['latent']
+    y = torch.load(b, map_location='cpu')['latent']
+    if torch.equal(x, y): eq += 1
+    else:
+        ne += 1
+        if first is None:
+            first = (p, ((x.float()-y.float()).norm()/y.float().norm()).item())
+print(f'B1d  ours (초기 noise + base_seed 모두 릴리스 규약) vs pristine: {eq}/{eq+ne} prompts')
+print('  -> 차이는 전부 난수 규약이었다' if ne == 0 else
+      f'  -> 난수를 통제해도 불일치: prompt {first[0]} rel={first[1]:.3e}. '
+      f'이제서야 난수 외 원인을 이분 탐색할 근거가 생긴다')
+PYG
+s6_verdict B1D_FULL_RNG
