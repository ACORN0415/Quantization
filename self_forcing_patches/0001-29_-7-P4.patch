+#!/usr/bin/env bash
+# B1c 가 끝나면 C1 비용 측정을 이어서. 마커 파일 대기(pgrep 자기참조 회피).
+set -u
+until grep -qE "B1C_SEED (DONE|INCOMPLETE)" ~/gpu/Self-Forcing/results/session6/b1c.log 2>/dev/null; do sleep 30; done
+echo "[queue2 $(date +%H:%M)] B1c 종료 -> C1 비용 측정"
+cd ~/gpu/sf-c1 && ./run_c1_cost.sh > ~/gpu/Self-Forcing/results/session6/c1cost.log 2>&1
+echo "[queue2 $(date +%H:%M)] C1 비용 rc=$?"
