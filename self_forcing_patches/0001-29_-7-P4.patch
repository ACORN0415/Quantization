+#
+# B2  final path quality AND performance from the same fixed source. The old
+#     perf rows have no source hash, so a new quality row cannot simply be
+#     attached to them.
+# B3  multi-prompt dump for L3/C2 (current dump is a single prompt).
+# B4  one harness measuring FA2 and fused v2 together, to end the
+#     +13.1% / +18.2% split.
+set -u
+cd ~/gpu/Self-Forcing
+. tools/runlib.sh
+PY=~/gpu/sf-venv/bin/python
+O=results/session6/b2; mkdir -p $O
+echo "source: $(git rev-parse HEAD)  dirty=$(git status --porcelain -- '*.py' | wc -l)"
