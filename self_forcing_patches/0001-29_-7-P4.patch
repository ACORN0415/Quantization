@@ -0,0 +1,103 @@
+#!/usr/bin/env bash
+# L1 — 저장 설계 단독 비교 (P1·P2·P3·P4). G1 조사의 "다음" 항목.
+#
+# 같은 모델·같은 토큰·같은 비트폭(RTN INT2)·같은 양자화기로 고정하고 **저장 방식만**
+# 바꾼다. P4(BF16 master)는 원래 LongLive 의 설계라 교차모델 비교가 되어 버리므로
+# Self-Forcing 안에 같은 성질로 구현해 넣었다(--kv_storage master).
+#
+# 먼저 관문 둘을 통과해야 본 실험으로 간다. 세션 5 교훈: 새 경로는 정답이 알려진
+# 사례를 먼저 통과해야 하고, 텐서 단위 등가만으로는 부족해 **생성 경로**에서 본다.
+set -u
+cd ~/gpu/Self-Forcing
+. tools/runlib.sh
+PY=~/gpu/sf-venv/bin/python
+O=results/session6/l1
+mkdir -p $O
+
+# ---------------------------------------------------------------- 관문 G-a
+# 기본 경로(rolling)가 내 패치로 바뀌지 않았는가. 세션 3 latent 와 비트 동일해야 한다.
+s6_run Ga_rolling_regress $PY inference.py --config_path configs/gateA_A1.yaml \
+  --checkpoint_path checkpoints/self_forcing_dmd.pt \
+  --data_path prompts/quant3/prompts3.txt --output_folder $O/ga/videos \
+  --stats_path $O/ga.stats.json --latent_dump_root $O/latents_ga \
+  --num_output_frames 63 --save_with_index --seed 0 --use_ema --no_decode \
+  --kv_quant RTN --kv_bits 2
+
+$PY - <<'PYG' | tee $O/ga_verdict.txt
+import torch, os
+R = os.path.expanduser('~/gpu/Self-Forcing/results')
+a, b = f'{R}/session6/l1/latents_ga', f'{R}/latents_gateA/A1_int2'
+eq = ne = 0
+for p in range(3):
+    for c in range(21):
+        fa, fb = f'{a}/prompt{p:03d}/chunk_{c:04d}.pt', f'{b}/prompt{p:03d}/chunk_{c:04d}.pt'
+        if not (os.path.exists(fa) and os.path.exists(fb)):
+            print(f'MISSING {fa if not os.path.exists(fa) else fb}'); raise SystemExit(1)
+        x = torch.load(fa, map_location='cpu')['latent']
+        y = torch.load(fb, map_location='cpu')['latent']
+        eq, ne = (eq + 1, ne) if torch.equal(x, y) else (eq, ne + 1)
+print(f'G-a rolling 회귀: {eq}/{eq+ne} bit-exact  ' + ('PASS' if ne == 0 else 'FAIL'))
+raise SystemExit(0 if ne == 0 else 1)
+PYG
+if [ "${PIPESTATUS[0]}" != 0 ]; then echo "G-a FAIL — 중단"; exit 1; fi
+
+# ---------------------------------------------------------------- 관문 G-b
+# master 가 (i) roped_key 로만 채워지고 (ii) 실제로 복원값과 달라야 한다.
+# (i) 는 실행 중 assert, (ii) 는 아래 norm 으로 본다. norm 이 0 이면 모드가
+# 아무 일도 안 하고 있다는 뜻이고, 그건 "구현했는데 안 붙은" 두 번째 사례가 된다.
+export L1_MASTER_ASSERT=1
+s6_run Gb_master_wiring $PY inference.py --config_path configs/gateA_A1.yaml \
+  --checkpoint_path checkpoints/self_forcing_dmd.pt \
+  --data_path prompts/quant3/prompts3.txt --output_folder $O/gb/videos \
+  --stats_path $O/gb.stats.json --latent_dump_root $O/latents_gb \
+  --num_output_frames 63 --save_with_index --seed 0 --use_ema --no_decode \
+  --kv_quant RTN --kv_bits 2 --kv_storage master \
+  --kv_master_stats $O/gb_master_stats.json
+unset L1_MASTER_ASSERT
+
+$PY - <<'PYG' | tee $O/gb_verdict.txt
+import json, os, torch
+O = os.path.expanduser('~/gpu/Self-Forcing/results/session6/l1')
+st = json.load(open(f'{O}/gb_master_stats.json'))
+nz = [e['master_minus_dequant_norm'] for e in st]
+pos = sum(1 for x in nz if x > 0)
+print(f'G-b 배선: 기록 {len(nz)}건, master≠복원값 {pos}건, '
+      f'중앙값 norm {sorted(nz)[len(nz)//2] if nz else float("nan"):.4g}')
+# master 모드는 rolling 과 달라야 한다(같으면 붙지 않은 것이다).
+eq = ne = 0
+for p in range(3):
+    for c in range(21):
+        fa = f'{O}/latents_gb/prompt{p:03d}/chunk_{c:04d}.pt'
+        fb = f'{O}/latents_ga/prompt{p:03d}/chunk_{c:04d}.pt'
+        x = torch.load(fa, map_location='cpu')['latent']
+        y = torch.load(fb, map_location='cpu')['latent']
+        eq, ne = (eq + 1, ne) if torch.equal(x, y) else (eq, ne + 1)
+print(f'G-b master vs rolling: {ne}/{eq+ne} 상이  ' + ('PASS' if eq == 0 else 'FAIL'))
+ok = bool(nz) and pos == len(nz) and eq == 0
+raise SystemExit(0 if ok else 1)
+PYG
+if [ "${PIPESTATUS[0]}" != 0 ]; then echo "G-b FAIL — 중단"; exit 1; fi
+
+# ---------------------------------------------------------------- 본 실험
+# 네 저장 설계, 같은 조건. 품질(MUSIQ)과 캐시 상주 바이트를 같은 런에서 낸다.
+arm () { tag="$1"; shift
+  s6_run "l1_$tag" $PY inference.py --config_path configs/gateA_A1.yaml \
+    --checkpoint_path checkpoints/self_forcing_dmd.pt \
+    --data_path prompts/quant3/prompts10.txt --output_folder $O/$tag/videos \
+    --stats_path $O/$tag.stats.json --kv_bytes_report $O/$tag.bytes.json \
+    --num_output_frames 63 --save_with_index --seed 0 --use_ema \
+    --kv_quant RTN --kv_bits 2 "$@"
+  s6_expect_files "l1_$tag.videos" 10 "$O/$tag/videos/*.mp4"; }
+
+arm p1_rolling
+arm p2_aligned  --kv_grid_align segment
+arm p3_fused    --attn_backend fused --fused_bias_lambda 0
+arm p4_master   --kv_storage master
+
+s6_run l1_musiq $PY /home/devel/gpu/Quantization/tools/metrics_all.py \
+  --runs p1_rolling=$O/p1_rolling/videos p2_aligned=$O/p2_aligned/videos \
+         p3_fused=$O/p3_fused/videos p4_master=$O/p4_master/videos \
+  --prompts prompts/quant3/prompts10.txt --skip lpips clip flow \
+  --out_csv results/session6/gateL1_storage_musiq.csv
+
+s6_verdict L1
