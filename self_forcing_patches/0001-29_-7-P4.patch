+  --kv_bytes_report $O/final_quality.bytes.json \
+  --num_output_frames 63 --save_with_index --seed 0 --use_ema $FINAL
+s6_expect_files final_quality.videos 10 "$O/final_quality/videos/*.mp4"
+
+# ---- B2b 성능 런 (같은 소스·설정, 훅 없음) -----------------------------------
+s6_run final_perf /usr/bin/time -f "%e wall_s" -o $O/final_perf.time \
+  $PY inference.py --config_path configs/gateA_A4.yaml \
+  --checkpoint_path checkpoints/self_forcing_dmd.pt \
+  --data_path prompts/quant3/prompts10.txt \
+  --output_folder $O/final_perf/videos --stats_path $O/final_perf.stats.json \
+  --kv_bytes_report $O/final_perf.bytes.json \
+  --num_output_frames 63 --seed 0 --use_ema --no_decode $FINAL
