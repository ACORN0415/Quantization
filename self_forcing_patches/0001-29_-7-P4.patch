+#!/usr/bin/env bash
+# Session 7 B1 (F1) — head to head against the released code.
+#
+# p0_ours_bf16 was never produced (the session-6 batch died on a duplicate
+# argparse option and still printed DONE). So "does our patch stack change the
+# released BF16 path" has never been answered. The 63-frame regression compares
+# our tree to OUR OWN earlier latents, which is a different question.
+#
+# Row 1 reuses the session-6 pristine videos: that individual artefact IS
+# complete (10 videos, EXIT=0) even though its batch was not -- provenance
+# checked per artefact, not per batch (session-7 directive, amended E).
+set -u
+cd ~/gpu/Self-Forcing
+. tools/runlib.sh
+PY=~/gpu/sf-venv/bin/python
+O=results/session6/b1_p0
+mkdir -p $O
+echo "source: $(git rev-parse HEAD) dirty=$(git status --porcelain -- '*.py' | wc -l)"
+
+# our tree, BF16, every new flag off -- same config the pristine row used
+s6_run ours_bf16 $PY inference.py --config_path configs/gateA_A1.yaml \
+  --checkpoint_path checkpoints/self_forcing_dmd.pt \
+  --data_path prompts/quant3/prompts10.txt \
+  --output_folder $O/ours_bf16/videos --stats_path $O/ours_bf16.stats.json \
+  --latent_dump_root $O/latents_ours_bf16 \
+  --kv_bytes_report $O/ours_bf16.bytes.json \
+  --num_output_frames 63 --save_with_index --seed 0 --use_ema
+s6_expect_files ours_bf16.videos 10 "$O/ours_bf16/videos/*.mp4"
+
+# pristine latents for the bit-exact question (the session-6 run decoded only)
+s6_run pristine_latents bash -c "cd ~/gpu/sf-pristine && $PY inference.py \
+  --config_path ~/gpu/Self-Forcing/configs/gateA_A1.yaml \
+  --checkpoint_path checkpoints/self_forcing_dmd.pt \
+  --data_path ~/gpu/Self-Forcing/prompts/quant3/prompts10.txt \
+  --output_folder ~/gpu/Self-Forcing/$O/pristine/videos \
+  --latent_dump_root ~/gpu/Self-Forcing/$O/latents_pristine \
+  --num_output_frames 63 --save_with_index --seed 0 --use_ema --no_decode"
+
+s6_run bitexact $PY - <<'PYG'
+import torch, os
+O = os.path.expanduser('~/gpu/Self-Forcing/results/session6/b1_p0')
+eq = ne = 0; first = None
+for p in range(10):
+    for c in range(21):
+        a = f'{O}/latents_ours_bf16/prompt{p:03d}/chunk_{c:04d}.pt'
+        b = f'{O}/latents_pristine/prompt{p:03d}/chunk_{c:04d}.pt'
+        if not (os.path.exists(a) and os.path.exists(b)):
+            print('missing', a if not os.path.exists(a) else b); raise SystemExit(1)
+        x = torch.load(a, map_location='cpu')['latent']
+        y = torch.load(b, map_location='cpu')['latent']
+        if torch.equal(x, y): eq += 1
+        else:
+            ne += 1
+            if first is None:
+                first = (p, c, ((x.float()-y.float()).norm()/y.float().norm()).item())
+print(f'B1 BIT-EXACT  ours BF16 vs pristine 33593df: {eq}/{eq+ne}'
+      + ('  PASS' if ne == 0 else f'  MISMATCH from p{first[0]} chunk {first[1]} rel={first[2]:.2e}'))
+PYG
+
+s6_run musiq $PY /home/devel/gpu/Quantization/tools/metrics_all.py \
+  --runs pristine=results/session6/b6/p0_pristine/videos ours_bf16=$O/ours_bf16/videos \
+  --prompts prompts/quant3/prompts10.txt --skip lpips clip flow \
+  --out_csv results/session6/gateP0_musiq.csv
+s6_verdict B1_P0
