+++ b/gateC6_mass.py
@@ -0,0 +1,162 @@
+# -*- coding: utf-8 -*-
+"""C6 — 보정이 캐시 attention mass 를 실제로 억제하는가 (주장 B10).
+
+B10: "정확형에서 층 29 outlier head 의 b 가 ~177 이므로, 캐시 logit 에서 그만큼을
+빼면 exp(-177)≈0 이 되어 그 head 의 캐시가 사실상 꺼진다." 지금까지 **수식에서
+유추**한 것이고 측정된 적이 없어 claim_table 에 '불가'로 남아 있었다.
+
+정확형은 생성으로 돌릴 수 없다(최소 30배 느려 실행 불가, S7_C1_exact_uniform_cost).
+그래서 **고정 logit 위의 반사실**로 답한다 — B10 은 즉각적인 softmax 효과에 대한
+주장이므로 이것이 오히려 정확한 검정이다.
+
+  보정 없음에서 캐시 mass c, self mass s=1-c 일 때, 캐시 logit 에서 상수 b 를 빼면
+      c'(b) = c e^{-b} / (s + c e^{-b})
+  (self 는 bias 0 이다 — TUM_EXCLUDE_SELF=True.)
+
+**공식을 먼저 정답이 알려진 경우로 검증한다**: b_taylor 를 넣어 나온 c' 가
+taylor 실행에서 **실제로 측정된** 캐시 mass 와 맞는지 본다. 맞으면 같은 공식에
+b_exact 를 넣은 값을 신뢰한다. 안 맞으면 반사실 자체를 쓰지 않는다.
+
+b 는 키마다 다르므로 대표값 두 개를 쓴다 — 중앙값과 p5(가장 덜 억제되는 키).
+살아남는 캐시 mass 는 b 가 작은 키가 지배하므로 p5 쪽이 보수적(억제에 불리)이다.
+"""
+import argparse, json, math, os, statistics as st, sys
+
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from gateC2_taylor import log_sinh_over_x
+
+
+def head_bias(r, max_pairs=40_000, seed=0):
+    """레코드 하나에서 head 별 b 분포 요약 (taylor / exact)."""
+    ds = r["delta_sq_blk"].double()          # [nb, H, D]
+    qs = r["q_sub"].double()                 # [nq, H, D]
+    D = ds.shape[-1]
+    nbc = (r["self_rel"][0] + 15) // 16      # 캐시 블록 수
+    if nbc < 1:
+        return None
+    delta = ds[:nbc].clamp(min=0).sqrt()
+    out = {}
+    for h in range(ds.shape[1]):
+        # a[iq, ib, c]
+        aa = (qs[:, h].abs().unsqueeze(1) * delta[:, h].unsqueeze(0)) \
+             / (2.0 * math.sqrt(D))
+        aa = aa.reshape(-1, D)
+        if aa.shape[0] > max_pairs:
+            g = torch.Generator().manual_seed(seed)
+            aa = aa[torch.randperm(aa.shape[0], generator=g)[:max_pairs]]
+        bt = (aa ** 2 / 6.0).sum(-1)
+        be = log_sinh_over_x(aa).sum(-1)
+        sb_t, sb_e = bt.sort().values, be.sort().values
+        p5 = max(0, int(0.05 * len(sb_t)) - 1)
+        out[h] = {"b_taylor_med": float(sb_t[len(sb_t) // 2]),
+                  "b_taylor_p5": float(sb_t[p5]),
+                  "b_exact_med": float(sb_e[len(sb_e) // 2]),
+                  "b_exact_p5": float(sb_e[p5])}
+    return out
+
+
+def cf(c, b):
+    """상수 b 를 캐시 logit 에서 뺐을 때의 캐시 mass."""
+    if b > 700:            # exp 언더플로 방지. e^{-700} 이면 어차피 0 이다.
+        return 0.0
+    w = c * math.exp(-b)
+    return w / max(1.0 - c + w, 1e-300)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lam0", required=True)
+    ap.add_argument("--taylor", required=True)
+    ap.add_argument("--dump", required=True)
+    ap.add_argument("--layers", type=int, nargs="*", default=[0, 15, 29])
+    ap.add_argument("--prompts", type=int, nargs="*", default=[0, 1, 2],
+                    help="mass 실행이 쓴 프롬프트 집합(prompts3 = prompts10 의 앞 3개)")
+    ap.add_argument("--out", default="results/session6/gateC6_mass")
+    a = ap.parse_args()
+
+    def mass(path):
+        recs = json.load(open(path))["records"]
+        agg = {}
+        for x in recs:
+            agg.setdefault((x["chunk"], x["layer"], x["head"]), []).append(x["cached"])
+        return {k: st.median(v) for k, v in agg.items()}
+
+    m0, mt = mass(a.lam0), mass(a.taylor)
+
+    recs = torch.load(a.dump, map_location="cpu", weights_only=False)
+    recs = [r for r in recs if int(r.get("prompt", 0)) in a.prompts
+            and int(r["layer"]) in a.layers]
+    bias = {}
+    for r in recs:
+        hb = head_bias(r)
+        if hb is None:
+            continue
+        for h, d in hb.items():
+            bias.setdefault((int(r["chunk"]), int(r["layer"]), h), []).append(d)
+    bias = {k: {kk: st.median([d[kk] for d in v]) for kk in v[0]}
+            for k, v in bias.items()}
+
+    rows = []
+    for k in sorted(bias):
+        if k not in m0 or k not in mt:
+            continue
+        c0 = m0[k]
+        b = bias[k]
+        rows.append({
+            "chunk": k[0], "layer": k[1], "head": k[2],
+            "cached_lam0": c0, "cached_taylor_measured": mt[k],
+            "cached_taylor_pred_med": cf(c0, b["b_taylor_med"]),
+            "cached_taylor_pred_p5": cf(c0, b["b_taylor_p5"]),
+            "cached_exact_pred_med": cf(c0, b["b_exact_med"]),
+            "cached_exact_pred_p5": cf(c0, b["b_exact_p5"]),
+            **b})
+
+    # ---- 검증: taylor 예측이 taylor 측정과 맞는가 --------------------------
+    err_med = [abs(r["cached_taylor_pred_med"] - r["cached_taylor_measured"])
+               for r in rows]
+    err_p5 = [abs(r["cached_taylor_pred_p5"] - r["cached_taylor_measured"])
+              for r in rows]
+    err_med.sort(); err_p5.sort()
+    def qq(v, p): return v[min(len(v) - 1, int(p * len(v)))]
+    print(f"검증 — taylor 반사실 vs taylor 실측 캐시 mass (n={len(rows)})")
+    print(f"  |차| 중앙 b 사용 : median {qq(err_med,.5):.4f}  p90 {qq(err_med,.9):.4f}")
+    print(f"  |차| p5 b 사용   : median {qq(err_p5,.5):.4f}  p90 {qq(err_p5,.9):.4f}")
+    valid = qq(err_med, .5) < 0.10 or qq(err_p5, .5) < 0.10
+    print("  → 반사실 공식 " + ("사용 가능" if valid else "**사용 불가**"))
+
+    print(f"\n{'chunk':>6}{'layer':>6}{'head':>5}"
+          f"{'b_exact(med)':>13}{'λ0 캐시':>9}{'taylor 실측':>12}"
+          f"{'정확형 예측':>12}")
+    for r in rows:
+        if r["layer"] != 29:
+            continue
+        print(f"{r['chunk']:6d}{r['layer']:6d}{r['head']:5d}"
+              f"{r['b_exact_med']:13.2f}{r['cached_lam0']:9.4f}"
+              f"{r['cached_taylor_measured']:12.4f}"
+              f"{r['cached_exact_pred_med']:12.4f}")
+
+    supp = [r for r in rows if r["cached_exact_pred_med"] < 0.01
+            and r["cached_lam0"] > 0.05]
+    print("\n판정 (정확형 반사실):")
+    if supp:
+        print(f"  **억제 관측됨** — {len(supp)}개 (chunk, layer, head)")
+        for r in supp[:10]:
+            print(f"    c{r['chunk']} L{r['layer']} h{r['head']}: "
+                  f"b_exact {r['b_exact_med']:.1f}, "
+                  f"{r['cached_lam0']:.4f} → {r['cached_exact_pred_med']:.2e}")
+    else:
+        print("  억제 없음 → B10 철회")
+
+    os.makedirs(os.path.dirname(a.out), exist_ok=True)
+    json.dump({"validation": {"abs_err_med_b": qq(err_med, .5),
+                              "abs_err_p5_b": qq(err_p5, .5),
+                              "usable": bool(valid)},
+               "n_suppressed": len(supp), "rows": rows},
+              open(a.out + ".json", "w"), indent=1, ensure_ascii=False)
+    print(f"\nwrote {a.out}.json")
+
+
+if __name__ == "__main__":
+    main()
