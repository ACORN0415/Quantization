diff --git a/wan/modules/causal_model.py b/wan/modules/causal_model.py
index b0c8a08..f1b954c 100644
--- a/wan/modules/causal_model.py
+++ b/wan/modules/causal_model.py
@@ -43,6 +43,29 @@ FUSED_BIAS_LAMBDA = 0.0  # >0: subtract the Taylor Jensen bias in-kernel
 #               was first quantized on and re-quantization is exactly
 #               idempotent. Same property the fused backend has by construction.
 KV_GRID_ALIGN = "off"
+# L1 저장 설계 비교. "rolling" = P1(복원값을 다시 양자화, BF16 master 없음),
+# "master" = P4(LongLive식: 원본 BF16을 남겨 두고 **원본에서** 다시 양자화).
+# 어텐션이 읽는 값은 두 모드 모두 역양자화 결과다 — 바뀌는 것은 재양자화 **입력**과
+# BF16 상주 여부뿐이다.
+KV_STORAGE = "rolling"
+# ---- L1 귀속 진단용 캡처 -------------------------------------------------
+# 양자화 **직전**의 BF16 캐시와 Q 를 통째로 저장한다. 두 양자화기·두 attention
+# 경로에 **같은 입력**을 먹이기 위한 것이다.
+#
+# 식별자는 (chunk, layer) 로 부족하다 — 같은 chunk 에서 denoising step 마다
+# 다시 호출되므로, 그 둘만으로 중복 제거하면 세션 6 도구 버그 7 을 되풀이한다.
+# prompt · seed · chunk · step(호출 순번) · call_site · layer · K/V 를 모두 적는다.
+ATTR_DUMP = None            # 저장 경로 (None 이면 꺼짐)
+ATTR_DUMP_POINTS = ()       # ((chunk, layer, step), ...) 캡처할 지점
+ATTR_SEED = None
+_ATTR_CALLS = {}            # (prompt, chunk, layer) -> 지금까지의 호출 수
