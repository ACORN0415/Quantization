diff --git a/gateL1_ulp_dist.py b/gateL1_ulp_dist.py
new file mode 100644
index 0000000..3148c01
--- /dev/null
+++ b/gateL1_ulp_dist.py
@@ -0,0 +1,125 @@
+# -*- coding: utf-8 -*-
+"""L1 진단 보조 — 두 attention 경로 출력 차이를 **bf16 ULP 단위**로 센다.
+
+ULP 규칙 (명시): bf16 은 가수 7비트이므로 0 이 아닌 x 에 대해
+    ulp(x) = 2^(floor(log2|x|) - 7)
+기준값(dequant→FA2 출력) x_ref 를 기준으로 삼는다. **x_ref == 0 인 원소는 ULP 가
+정의되지 않으므로 분포에서 제외하고 따로 센다** — 그 칸은 "둘 다 0" 인지
+"한쪽만 0" 인지로만 보고한다. 서브노멀(|x| < 2^-126)도 같은 이유로 분리한다.
+기준값을 1e-30 따위로 clamp 해서 비율을 만들지 않는다 (그렇게 하면 0 근처에서
+무한대에 가까운 ULP 수가 생기고, 그것은 계산 인공물이다).
+"""
+import argparse, glob, json, os, sys
+
+import torch
+
+sys.path.insert(0, os.path.abspath(os.path.dirname(__file__)))
+from kernels.triton_kv_quant import triton_quantize_kv, unpack_reference
+from kernels.triton_fused_lowbit_attn import fused_lowbit_attention_v2
+from wan.modules.attention import attention
+
+SUBNORMAL = 2.0 ** -126
+
+
+def both_paths(rec, bits, dev="cuda"):
+    sk, sv = rec["src_k"].to(dev), rec["src_v"].to(dev)
+    q = rec["q"].to(dev)
+    s0, s1 = rec["self_rel"]
+    L = int(rec["num_new_tokens"])
+    segs = []
+    for a in range(0, s0, L):
+        pk, ks = triton_quantize_kv(sk[:, a:a + L].contiguous(), bits)
+        pv, vs = triton_quantize_kv(sv[:, a:a + L].contiguous(), bits)
+        segs.append((pk, ks, pv, vs))
+    PK = torch.cat([s[0] for s in segs], 2); KS = torch.cat([s[1] for s in segs], 2)
+    PV = torch.cat([s[2] for s in segs], 2); VS = torch.cat([s[3] for s in segs], 2)
+    xa = fused_lowbit_attention_v2(
+        q, PK, KS, PV, VS, sk[:, s0:s1].contiguous(), sv[:, s0:s1].contiguous(),
+        key_bits=bits, value_bits=bits, bias_lambda=0.0,
+        seg_len=L, seg_nb=(L + 15) // 16,
+        block_m=128, block_n=32, num_warps=4, num_stages=2)
+    dk = torch.cat([unpack_reference(s[0], s[1], bits) for s in segs], 1)
+    dv = torch.cat([unpack_reference(s[2], s[3], bits) for s in segs], 1)
+    xb = attention(q, torch.cat([dk, sk[:, s0:s1]], 1),
+                   torch.cat([dv, sv[:, s0:s1]], 1))
+    return xa, xb, len(segs)
+
+
+def ulp_stats(xa, xb):
+    a, b = xa.float(), xb.float()
+    d = (a - b).abs()
+    tot = b.numel()
+    zero = b == 0
+    sub = (~zero) & (b.abs() < SUBNORMAL)
+    ok = ~(zero | sub)
+    e = torch.floor(torch.log2(b[ok].abs()))
+    n_ulp = d[ok] / torch.pow(2.0, e - 7)
+    out = {
+        "n_total": int(tot),
+        "n_ref_zero": int(zero.sum()),
+        "n_ref_zero_and_other_zero": int((zero & (a == 0)).sum()),
+        "n_ref_subnormal": int(sub.sum()),
+        "n_in_distribution": int(ok.sum()),
+        "frac_exact_overall": float((d == 0).float().mean()),
+    }
+    for t in (0, 1, 2, 4, 8):
+        out[f"frac_le_{t}_ulp"] = float((n_ulp <= t + 1e-6).float().mean())
+    out["max_ulp"] = float(n_ulp.max())
+    # 큰 ULP 수가 "기준값이 작아서" 생긴 것인지 밝힌다. 0 은 이미 제외했으므로
+    # 여기 남는 것은 정상수지만 매우 작은 값일 수 있다.
+    ref_ok = b[ok].abs()
+    i = int(torch.argmax(n_ulp))
+    out["ref_abs_at_max_ulp"] = float(ref_ok[i])
+    out["abs_diff_at_max_ulp"] = float(d[ok][i])
+    big = n_ulp > 8
+    out["n_gt_8_ulp"] = int(big.sum())
+    if int(big.sum()):
+        rb = ref_ok[big].sort().values
+        out["ref_abs_median_where_gt_8_ulp"] = float(rb[len(rb) // 2])
+        out["ref_abs_p90_where_gt_8_ulp"] = float(rb[int(0.9 * len(rb))])
+    out["ref_abs_median_all"] = float(ref_ok.median())
+    s = n_ulp.sort().values
+    out["p99_ulp"] = float(s[int(0.99 * len(s))])
+    out["p999_ulp"] = float(s[int(0.999 * len(s))])
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--points", required=True)
+    ap.add_argument("--bits", type=int, default=2)
+    ap.add_argument("--out", default="results/ulp_dist")
+    a = ap.parse_args()
+    rows = []
+    for f in sorted(glob.glob(os.path.join(a.points, "*.pt"))):
+        rec = torch.load(f, map_location="cpu", weights_only=False)
+        xa, xb, nseg = both_paths(rec, a.bits)
+        st = ulp_stats(xa, xb)
+        st.update({"file": os.path.basename(f), "bits": a.bits, "n_segs": nseg,
+                   "ident": {k: rec[k] for k in ("prompt", "seed", "chunk",
+                                                 "layer", "step", "call_site")}})
+        rows.append(st)
+        print(f"\n=== {st['file']}  bits={a.bits} ===")
+        print(f"  전체 {st['n_total']:,} · 기준 0 인 원소 {st['n_ref_zero']:,} "
+              f"(그중 양쪽 0 {st['n_ref_zero_and_other_zero']:,}) · "
+              f"서브노멀 {st['n_ref_subnormal']:,}")
+        print(f"  분포 대상 {st['n_in_distribution']:,}")
+        for t in (0, 1, 2, 4, 8):
+            print(f"    ≤{t} ULP : {100*st[f'frac_le_{t}_ulp']:7.4f}%")
+        print(f"    p99 {st['p99_ulp']:.1f} · p99.9 {st['p999_ulp']:.1f} · "
+              f"max {st['max_ulp']:.1f} ULP")
+        print(f"    >8 ULP 인 원소 {st['n_gt_8_ulp']:,}개 — 그 기준값 |x| 중앙 "
+              f"{st.get('ref_abs_median_where_gt_8_ulp', float('nan')):.3e} "
+              f"(전체 중앙 {st['ref_abs_median_all']:.3e})")
+        print(f"    max ULP 지점: 기준값 |x|={st['ref_abs_at_max_ulp']:.3e}, "
+              f"|Δ|={st['abs_diff_at_max_ulp']:.3e}")
+        del rec, xa, xb
+        torch.cuda.empty_cache()
+    os.makedirs(os.path.dirname(a.out) or ".", exist_ok=True)
+    json.dump({"ulp_rule": "ulp(x)=2^(floor(log2|x|)-7); 기준값 0·서브노멀은 분포에서 제외하고 따로 셈",
+               "rows": rows}, open(a.out + ".json", "w"), indent=1, ensure_ascii=False)
+    print(f"\nwrote {a.out}.json")
+
+
+if __name__ == "__main__":
+    main()
