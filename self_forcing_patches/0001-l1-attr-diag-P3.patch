index 0000000..2a7e435
--- /dev/null
+++ b/gateL1_attn_diag.py
@@ -0,0 +1,108 @@
+# -*- coding: utf-8 -*-
+"""L1 진단 (iii) — dequant→FA2 경로와 fused 경로에 **같은 저장 상태**를 먹인다.
+
+맞추는 것: 양자화 상태(같은 packed 세그먼트) · 현재 BF16 chunk · 토큰 순서 ·
+마스크 · 위치(캡처된 roped Q/K 를 그대로 쓴다) · 보정 설정(bias_lambda = 0).
+
+출력 오차는 **절대·상대를 함께** 기록한다. 이 값은 **MUSIQ 영향의 상한이 아니다** —
+한 상태에서의 대응 확인일 뿐이다.
+"""
+import argparse, glob, json, os, sys
+
+import torch
+
+sys.path.insert(0, os.path.abspath(os.path.dirname(__file__)))
+sys.path.insert(0, os.path.join(os.path.abspath(os.path.dirname(__file__)), "kernels"))
+from kernels.triton_kv_quant import triton_quantize_kv, unpack_reference
+from kernels.triton_fused_lowbit_attn import fused_lowbit_attention_v2
+from wan.modules.attention import attention
+
+
+def run_point(rec, bits, dev):
+    src_k = rec["src_k"].to(dev)
+    src_v = rec["src_v"].to(dev)
+    q = rec["q"].to(dev)
+    s0, s1 = rec["self_rel"]
+    seg_len = int(rec["num_new_tokens"])
+    assert s1 - s0 == seg_len, (s0, s1, seg_len)
+
+    # 현재 chunk 는 BF16 self, 그 앞은 packed 세그먼트 — fused 경로의 상태 구성 그대로
+    self_k, self_v = src_k[:, s0:s1].contiguous(), src_v[:, s0:s1].contiguous()
+    segs = []
+    for a in range(0, s0, seg_len):
+        b = a + seg_len
+        pk, ks = triton_quantize_kv(src_k[:, a:b].contiguous(), bits)
+        pv, vs = triton_quantize_kv(src_v[:, a:b].contiguous(), bits)
+        segs.append((pk, ks, pv, vs))
+    assert segs, "캐시 세그먼트가 없다"
+
+    PK = torch.cat([s[0] for s in segs], dim=2)
+    KS = torch.cat([s[1] for s in segs], dim=2)
+    PV = torch.cat([s[2] for s in segs], dim=2)
+    VS = torch.cat([s[3] for s in segs], dim=2)
+    seg_nb = (seg_len + 15) // 16
+
+    # --- 경로 A: fused (보정 끔) ---
+    xa = fused_lowbit_attention_v2(
+        q, PK, KS, PV, VS, self_k, self_v,
+        key_bits=bits, value_bits=bits, bias_lambda=0.0,
+        seg_len=seg_len, seg_nb=seg_nb,
+        block_m=128, block_n=32, num_warps=4, num_stages=2)
+
+    # --- 경로 B: 같은 상태를 복원해 FA2 ---
+    dk = torch.cat([unpack_reference(s[0], s[1], bits) for s in segs], dim=1)
+    dv = torch.cat([unpack_reference(s[2], s[3], bits) for s in segs], dim=1)
+    K = torch.cat([dk, self_k], dim=1)
+    V = torch.cat([dv, self_v], dim=1)
+    xb = attention(q, K, V)
+
+    d = (xa.float() - xb.float()).abs()
+    den = xb.float().abs()
+    ok = den > 1e-6
+    rel = torch.zeros_like(d); rel[ok] = d[ok] / den[ok]
+    rs = rel[ok].flatten().sort().values
+    return {
+        "tokens": int(src_k.shape[1]), "cached_tokens": int(s0),
+        "self_tokens": seg_len, "n_segs": len(segs),
+        "abs": {"max": float(d.max()), "mean": float(d.mean()),
+                "p99": float(d.flatten().sort().values[int(0.99 * d.numel())])},
+        "rel_where_ref_gt_1e-6": {
+            "max": float(rs[-1]), "p99": float(rs[int(0.99 * len(rs))]),
+            "median": float(rs[len(rs) // 2]), "frac_defined": float(ok.float().mean())},
+        "ref_scale": {"mean_abs": float(den.mean()), "max_abs": float(den.max())},
+    }
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--points", required=True)
+    ap.add_argument("--bits", type=int, default=2)
+    ap.add_argument("--out", default="results/attn_diag")
+    a = ap.parse_args()
+    rows = []
+    for f in sorted(glob.glob(os.path.join(a.points, "*.pt"))):
+        rec = torch.load(f, map_location="cpu", weights_only=False)
+        ident = {k: rec[k] for k in ("prompt", "seed", "chunk", "layer", "step",
+                                     "call_site")}
+        r = run_point(rec, a.bits, "cuda")
+        rows.append({"file": os.path.basename(f), "ident": ident, **r})
+        print(f"\n=== {os.path.basename(f)} ===")
+        print("  식별자:", json.dumps(ident, ensure_ascii=False))
+        print(f"  캐시 {r['cached_tokens']} 토큰 / 세그먼트 {r['n_segs']}개 "
+              f"+ self {r['self_tokens']}")
+        print(f"  절대오차  max {r['abs']['max']:.3e}  평균 {r['abs']['mean']:.3e}  "
+              f"p99 {r['abs']['p99']:.3e}")
+        print(f"  상대오차  max {r['rel_where_ref_gt_1e-6']['max']:.3e}  "
+              f"p99 {r['rel_where_ref_gt_1e-6']['p99']:.3e}  "
+              f"중앙 {r['rel_where_ref_gt_1e-6']['median']:.3e}")
+        print(f"  (기준 출력 크기: 평균|x| {r['ref_scale']['mean_abs']:.3e})")
+        del rec
+        torch.cuda.empty_cache()
+    os.makedirs(os.path.dirname(a.out) or ".", exist_ok=True)
+    json.dump({"note": "한 상태에서의 대응 확인. MUSIQ 영향의 상한이 아니다.",
+               "rows": rows}, open(a.out + ".json", "w"), indent=1, ensure_ascii=False)
+    print(f"\nwrote {a.out}.json")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/gateL1_attr_diag.py b/gateL1_attr_diag.py
new file mode 100644
index 0000000..9fcfda0
--- /dev/null
+++ b/gateL1_attr_diag.py
@@ -0,0 +1,119 @@
+# -*- coding: utf-8 -*-
+"""L1 진단 — P3 경로의 두 구성요소에서 **관측되는 불일치를 찾고 범위를 확인한다.**
+
+이 진단은 요인을 "닫지" 않는다. 생성에서 뽑은 **일부** 상태에 대한 대조이며,
+결론은 **"시험한 상태에서 대응을 확인했다"**까지다. 차이가 작거나 검출되지
+않더라도 +2.65 의 인과 귀속은 완결되지 않는다.
+
+(i) 양자화기 산술 — torch RTN vs Triton
+    같은 BF16 입력·같은 그룹 경계(block 16, 토큰 축)에서 비교하되
+    **packed byte 가 아니라**:
+      · unpack 한 **코드**(부호 규약을 맞춘 뒤)
+      · 대응 **scale**
+      · **복원 K/V**
+    셋을 각각 본다. 레이아웃·인코딩 차이를 수치 오류로 오인하지 않기 위해서다.
+      - RTN   : q 는 int8 [-2^(b-1), 2^(b-1)-1], 블록 [B, nb, 16, H, D]
+      - Triton: packed uint8, 코드 = q + 2^(b-1) (offset binary), [B, H, L, D/pack]
+
+(iii) attention 경로 — dequant→FA2 vs fused
+    **같은 저장 상태와 같은 Q** 를 두 경로에 넣는다. 토큰 순서·마스크·위치·
+    보정 설정을 맞추고, 출력은 **절대·상대 오차를 함께** 기록한다.
+    이 값을 MUSIQ 영향의 상한으로 쓰지 않는다.
+"""
+import argparse, glob, json, os, sys
+
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.expanduser("~/gpu/kv-quant-longhorizon"))
+from kv_quant.factory import create_quantizer
+from kernels.triton_kv_quant import triton_quantize_kv, unpack_reference, BLOCK_TOKENS
+
+
+def rtn_codes_scales(x, bits, block=16):
+    """RTN 의 q·scale 을 Triton 레이아웃 [B,H,L,D] / [B,H,nb,D] 으로 맞춰 돌려준다."""
+    from kv_quant.utils import _reshape_blocks, quantize_sym
+    xb, pad = _reshape_blocks(x, block)                  # [B, nb, 16, H, D]
+    q, sc = quantize_sym(xb, bits=bits, reduce_dims=(2,))  # q 같은 모양, sc [B,nb,1,H,D]
+    b, nb, bs, h, d = q.shape
+    q = q.permute(0, 3, 1, 2, 4).reshape(b, h, nb * bs, d)  # [B,H,L+pad,D]
+    sc = sc.squeeze(2).permute(0, 2, 1, 3)                  # [B,H,nb,D]
+    return q, sc, pad
+
+
+def cmp(a, b):
+    a, b = a.float(), b.float()
+    diff = (a - b).abs()
+    den = b.abs().clamp_min(1e-12)
+    return {"max_abs": float(diff.max()), "mean_abs": float(diff.mean()),
+            "max_rel": float((diff / den).max()),
+            "p99_rel": float((diff / den).flatten().sort().values[
+                int(0.99 * diff.numel())]),
+            "n_mismatch": int((a != b).sum()), "n": int(a.numel())}
+
+
+def diag_quantizer(rec, bits, tag, dev):
+    x = rec[f"src_{tag}"].to(dev)                       # [B, L, H, D] bf16
+    L = x.shape[1]
+    qr, scr, pad = rtn_codes_scales(x, bits)
+    packed, sct = triton_quantize_kv(x.contiguous(), bits)
+    # 코드: offset binary -> signed. 패딩 구간은 제외한다.
+    pack = 8 // bits
+    mask = (1 << bits) - 1
+    shifts = torch.arange(pack, device=dev, dtype=torch.uint8) * bits
+    codes = (packed.unsqueeze(-1) >> shifts) & mask
+    qt = codes.to(torch.int16).reshape(*packed.shape[:3], -1) - (1 << (bits - 1))
+    out = {
+        "tokens": L, "pad_len": pad, "bits": bits,
+        "codes": cmp(qr[:, :, :L].to(torch.int16), qt),
+        "scales": cmp(scr, sct),
+        "recon": cmp(
+            unpack_reference(packed, sct, bits).permute(0, 2, 1, 3),
+            (qr[:, :, :L].to(torch.bfloat16)
+             * scr.repeat_interleave(BLOCK_TOKENS, dim=2)[:, :, :L].to(torch.bfloat16))),
+    }
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--points", required=True)
+    ap.add_argument("--bits", type=int, default=2)
+    ap.add_argument("--out", default="results/attr_diag")
+    a = ap.parse_args()
+    dev = "cuda"
+    files = sorted(glob.glob(os.path.join(a.points, "*.pt")))
+    if not files:
+        raise SystemExit(f"덤프 없음: {a.points}")
+    res = []
+    for f in files:
+        rec = torch.load(f, map_location="cpu", weights_only=False)
+        ident = {k: rec[k] for k in ("prompt", "seed", "chunk", "layer", "step",
+                                     "call_site", "local_end_index",
+                                     "num_new_tokens", "sink_tokens",
+                                     "grid_align", "storage")}
+        print(f"\n=== {os.path.basename(f)} ===")
+        print("  식별자:", json.dumps(ident, ensure_ascii=False))
+        row = {"file": os.path.basename(f), "ident": ident, "quantizer": {}}
+        for tag in ("k", "v"):
+            d = diag_quantizer(rec, a.bits, tag, dev)
+            row["quantizer"][tag] = d
+            print(f"  [{tag.upper()}] tokens={d['tokens']} pad={d['pad_len']}")
+            print(f"    코드   불일치 {d['codes']['n_mismatch']:,} / "
+                  f"{d['codes']['n']:,}   max|Δ| {d['codes']['max_abs']:.0f}")
+            print(f"    scale  불일치 {d['scales']['n_mismatch']:,} / "
+                  f"{d['scales']['n']:,}   max|Δ| {d['scales']['max_abs']:.3e}")
+            print(f"    복원   max|Δ| {d['recon']['max_abs']:.3e}  "
+                  f"평균|Δ| {d['recon']['mean_abs']:.3e}  "
+                  f"p99 상대 {d['recon']['p99_rel']:.3e}")
+        res.append(row)
+        del rec
+        torch.cuda.empty_cache()
+    os.makedirs(os.path.dirname(a.out) or ".", exist_ok=True)
+    json.dump({"note": "시험한 상태에서의 대응 확인이며 MUSIQ 영향의 상한이 아니다",
+               "rows": res}, open(a.out + ".json", "w"), indent=1, ensure_ascii=False)
+    print(f"\nwrote {a.out}.json")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/gateL1_quant_sensitivity.py b/gateL1_quant_sensitivity.py
new file mode 100644
index 0000000..47ce835
--- /dev/null
+++ b/gateL1_quant_sensitivity.py
@@ -0,0 +1,80 @@
+# -*- coding: utf-8 -*-
+"""L1 진단 보조 — 양자화기 대조가 **차이를 검출할 수 있는지** 확인한다.
+
+완전 일치(0 불일치)를 확인으로 읽기 전에 필요한 음성 대조다(절차 규칙 7:
+"독립이어야 할 두 측정이 소수점까지 같으면 동일성을 의심한다").
+
+실행 조건은 결과 JSON 에 함께 기록한다.
+"""
+import argparse, json, os, sys
+
+import torch
+
+sys.path.insert(0, os.path.abspath(os.path.dirname(__file__)))
+sys.path.insert(0, os.path.expanduser("~/gpu/kv-quant-longhorizon"))
+from gateL1_attr_diag import rtn_codes_scales
+from kernels.triton_kv_quant import triton_quantize_kv
+
+
+def tri_codes(x, bits):
+    p, sc = triton_quantize_kv(x, bits)
+    pack = 8 // bits
+    mask = (1 << bits) - 1
+    shifts = torch.arange(pack, device=x.device, dtype=torch.uint8) * bits
+    c = (p.unsqueeze(-1) >> shifts) & mask
+    return c.to(torch.int16).reshape(*p.shape[:3], -1) - (1 << (bits - 1)), sc
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--point", required=True, help="캡처 .pt 파일")
+    ap.add_argument("--tokens", type=int, default=2048, help="앞에서 자를 토큰 수")
+    ap.add_argument("--bits", type=int, default=2)
+    ap.add_argument("--sigma", type=float, default=0.05)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--out", default="results/quant_sensitivity")
+    a = ap.parse_args()
+
+    rec = torch.load(a.point, map_location="cpu", weights_only=False)
+    x = rec["src_k"][:, :a.tokens].cuda().contiguous()
+    qa, sa, _ = rtn_codes_scales(x, a.bits)
+    qa = qa[:, :, :x.shape[1]].to(torch.int16)
+
+    out = {"point": os.path.basename(a.point),
+           "ident": {k: rec[k] for k in ("prompt", "seed", "chunk", "layer",
+                                         "step", "call_site")},
+           "tokens": a.tokens, "bits": a.bits, "sigma": a.sigma,
+           "rng_seed": a.seed, "tensor": "src_k",
+           "n_codes": int(qa.numel()), "n_scales": int(sa.numel()), "cases": {}}
+
+    # 1) 동일 입력 — 일치해야 한다
+    qb, sb = tri_codes(x, a.bits)
+    out["cases"]["identical_input"] = {
+        "code_mismatch": int((qa != qb).sum()), "scale_mismatch": int((sa != sb).sum())}
+
+    # 2) 한쪽 입력만 섭동 — 불일치가 나와야 한다
+    g = torch.Generator(device="cuda").manual_seed(a.seed)
