+# LongLive keeps the live cache in kv_cache["k"]/["v"] and builds a throwaway
+# temp_k/temp_v for attention, so quantization is applied at the two read sites
+# and once per write-back in _update_kv_cache.
+KV_QUANTIZER = None
+KV_ERR_LOG = None
+KV_SINK_BF16 = False
+
+
+def _kv_read(cache, key):
+    """Return the cache tensor a forward pass should attend over."""
+    if KV_QUANTIZER is None or cache.get("quant_state") is None:
+        return cache[key].clone()
+    rk, rv = KV_QUANTIZER.dequantize_kv(
+        cache["quant_state"], meta={"tensor_dtype": cache[key].dtype})
+    out = (rk if key == "k" else rv).to(device=cache[key].device, dtype=cache[key].dtype)
+    if KV_SINK_BF16:
+        # Sink slots stay in BF16; only the rolling window is quantized.
+        st = int(cache.get("sink_tokens", 0))
+        if st > 0:
+            out = out.clone()
+            out[:, :st] = cache[key][:, :st]
+    return out
