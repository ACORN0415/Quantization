+# Gate E2: replace what sits in the sink slot, keeping its position and size.
+# "int2"     quantize the sink content to INT2 and back  (a contaminated anchor)
+# "noise"    Gaussian noise at the sink's own norm       (position only, no content)
+# "freeze"   capture the sink once, then hold it fixed   (re-quantization is
+#                                                         near-idempotent, so this
+#                                                         should change nothing)
+# "override" content supplied externally, e.g. another prompt's chunk 0
+SINK_MODE = None
+SINK_TENSORS = {}       # layer index -> (k, v) for "override"/"freeze"
+SINK_LAYER_COUNTER = [0]
