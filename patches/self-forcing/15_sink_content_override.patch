+def _apply_sink_mode(cache_k, cache_v, sink_tokens, layer_id):
+    """Rewrite cache[:, :sink_tokens] according to SINK_MODE."""
+    import torch as _t
+    if not SINK_MODE or sink_tokens <= 0:
+        return
+    k_slot = cache_k[:, :sink_tokens]
+    v_slot = cache_v[:, :sink_tokens]
+
+    if SINK_MODE == "noise":
+        g = _t.Generator(device=k_slot.device); g.manual_seed(20260916 + layer_id)
+        for slot in (k_slot, v_slot):
+            n = _t.randn(slot.shape, generator=g, device=slot.device, dtype=_t.float32)
+            n = n / n.norm().clamp(min=1e-12) * slot.float().norm()
+            slot.copy_(n.to(slot.dtype))
+        return
+
+    if SINK_MODE == "int2":
+        import sys as _s
+        _p = os.path.expanduser("~/gpu/kv-quant-longhorizon")
+        if _p not in _s.path:
+            _s.path.insert(0, _p)
+        from kv_quant.factory import create_quantizer
+        q = create_quantizer("RTN", bits=2, block_size=16,
+                             key_bits=2, value_bits=2, name="RTN_INT2")
+        st = q.quantize_kv(k_slot, v_slot, meta={"tensor_dtype": k_slot.dtype})
+        rk, rv = q.dequantize_kv(st, meta={"tensor_dtype": k_slot.dtype})
+        k_slot.copy_(rk.to(k_slot.dtype)); v_slot.copy_(rv.to(v_slot.dtype))
+        return
+
+    if SINK_MODE in ("freeze", "override"):
+        if layer_id not in SINK_TENSORS:
+            if SINK_MODE == "freeze":
+                SINK_TENSORS[layer_id] = (k_slot.detach().clone(), v_slot.detach().clone())
+            return
+        k_ref, v_ref = SINK_TENSORS[layer_id]
+        k_slot.copy_(k_ref.to(k_slot.dtype)); v_slot.copy_(v_ref.to(v_slot.dtype))
+        return
+
