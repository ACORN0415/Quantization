+def gpu_frames(k,hm):
+    # Explicit 2D mm removes singleton-stride-dependent matmul dispatch.
+    z=(k.reshape(-1,128).float()@hm).to(k.dtype).reshape(3,1560,12,128)
+    z=torch.cat((z,z.new_zeros(3,8,12,128)),1).reshape(3,98,16,12,128)
+    s=(z.abs().amax(2,keepdim=True)/7).clamp_min(1e-8)
+    return z,s.to(torch.float16)
+
 
